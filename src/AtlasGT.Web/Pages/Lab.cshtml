@page
@model LabModel
@{
    ViewData["Title"] = "Device Lab";
}

<section class="card">
  <h2>Device Lab — tripas visibles</h2>
  <p class="muted">Aca ves el pipeline: raw → mapping → correlacion → evidencia → confidence → profile. Para tecnicos, no para operacion diaria.</p>
</section>

<section class="card">
  <h3 class="section-sub">1. Escaneo pasivo TCP</h3>
  <form id="scanForm">
    <div class="row">
      <div class="field"><label>Host/IP</label><input name="host" required value="127.0.0.1" /></div>
      <div class="field"><label>Autorizacion (obligatoria, auditada)</label><input name="auth" required placeholder="p.ej. OT-ticket-123" /></div>
      <div class="field"><label>Puertos (csv)</label><input name="ports" placeholder="502,4840,1883,80" /></div>
      <div class="field" style="align-self:end;"><button type="submit">Escanear</button></div>
    </div>
  </form>
  <pre id="scanResult" class="muted">—</pre>
</section>

<section class="card">
  <h3 class="section-sub">2. Publicar observacion cruda (sandbox)</h3>
  <form id="pubForm">
    <div class="row">
      <div class="field"><label>Señal (key)</label><input name="signalKey" required value="register.test" /></div>
      <div class="field"><label>Valor</label><input name="value" type="number" step="any" value="1" /></div>
      <div class="field"><label>Unidad</label><input name="unit" /></div>
      <div class="field" style="align-self:end;"><button type="submit">Publicar</button></div>
    </div>
  </form>
  <p class="muted">Aparecera como TrustTier=Observed, Provenance=Sandbox en el bus SignalR.</p>
</section>

<section class="card">
  <h3 class="section-sub">3. Diagnostico (Doctor) de endpoint</h3>
  <div class="row">
    <div class="field" style="flex:1"><label>Endpoint</label><select id="epSelect"></select></div>
    <div class="field" style="align-self:end"><button id="diagBtn">Diagnosticar</button></div>
  </div>
  <pre id="diagResult">—</pre>
</section>

<section class="card">
  <h3 class="section-sub">4. Alarma activas en vivo</h3>
  <table id="alarmsTable"><thead><tr><th>Regla</th><th>Señal</th><th>Valor</th><th>Severidad</th><th>Estado</th></tr></thead><tbody><tr><td colspan="5" class="muted">—</td></tr></tbody></table>
</section>

@section Scripts {
<script>
(function () {
  const api = '@Model.ApiBaseUrl';
  const $ = s => document.querySelector(s);
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  async function call(path, opts) {
    const r = await fetch(api + path, opts);
    if (!r.ok) throw new Error(await r.text());
    return r.status === 204 ? null : r.json();
  }

  $('#scanForm').onsubmit = async e => {
    e.preventDefault();
    const f = new FormData(e.target);
    const portsCsv = f.get('ports');
    const ports = portsCsv ? portsCsv.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n)) : null;
    $('#scanResult').textContent = 'escaneando…';
    try {
      const r = await call('/api/discovery/tcp-scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ host: f.get('host'), authorizationToken: f.get('auth'), ports })
      });
      $('#scanResult').textContent = JSON.stringify(r, null, 2);
    } catch (err) { $('#scanResult').textContent = 'error: ' + err.message; }
  };

  $('#pubForm').onsubmit = async e => {
    e.preventDefault();
    const f = new FormData(e.target);
    await call('/api/sandbox/publish', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ signalKey: f.get('signalKey'), value: parseFloat(f.get('value')), unit: f.get('unit') })
    });
    refreshAlarms();
  };

  async function loadEndpointsIntoDiag() {
    const rows = await call('/api/endpoints');
    $('#epSelect').innerHTML = rows.map(e => `<option value="${e.id}">${esc(e.name)} — ${esc(e.address)}</option>`).join('') || '<option value="">— sin endpoints —</option>';
  }
  $('#diagBtn').onclick = async () => {
    const id = $('#epSelect').value;
    if (!id) { $('#diagResult').textContent = 'elige endpoint primero'; return; }
    const r = await call('/api/endpoints/' + id + '/diagnose');
    $('#diagResult').textContent = JSON.stringify(r, null, 2);
  };

  async function refreshAlarms() {
    const rows = await call('/api/alarms/active');
    $('#alarmsTable tbody').innerHTML = rows.length
      ? rows.map(a => `<tr><td>${esc(a.ruleName)}</td><td>${esc(a.signalKey)}</td><td>${a.value}</td><td>${a.severity}</td><td>${a.state}</td></tr>`).join('')
      : '<tr><td colspan="5" class="muted">Sin alarmas activas.</td></tr>';
  }

  loadEndpointsIntoDiag();
  refreshAlarms();
})();
</script>
}
